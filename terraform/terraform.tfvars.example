# Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.

aws_region   = "us-east-1"
project_name = "tech-challenge-2"

# GitOps settings
github_repository = "your-github-user/tech-challenge-2"
gitops_branch     = "gitops"

# Fine-grained token: this repo only, Contents = Read-only. Lets Argo CD read
# the private repo. Better: export TF_VAR_github_token=... instead of saving it here.
# github_token = "github_pat_..."

# Set to false if your AWS account already has the GitHub OIDC provider
# create_github_oidc_provider = true

# Defaults that already match the challenge spec:
# node_instance_type = "t3.small"
# node_min_size      = 1
# node_max_size      = 4
# node_desired_size  = 1
